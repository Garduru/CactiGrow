{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cactigrow-deploy-disabled",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CACTIGROW_ENVIRONMENT": "production",
    "CACTIGROW_VERSION": "0.0.0"
  },
  "env": {
    "development": {
      "name": "cactigrow-api-development",
      "workers_dev": true,
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "5b3c20f4901843799c7105fe6901c166" }],
      "vars": {
        "CACTIGROW_ENVIRONMENT": "development",
        "CACTIGROW_VERSION": "0.0.0"
      }
    },
    "test": {
      "name": "cactigrow-api-test",
      // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<test-hyperdrive-id>" }],
      "vars": {
        "CACTIGROW_ENVIRONMENT": "test",
        "CACTIGROW_VERSION": "0.0.0"
      }
    },
    "staging": {
      "name": "cactigrow-staging",
      "durable_objects": { "bindings": [{ "name": "AREA_PRESENCE", "class_name": "AreaPresence" }] },
      "exports": { "AreaPresence": { "type": "durable-object", "storage": "sqlite" } },
      "workers_dev": false,
      "routes": [{ "pattern": "dev.cactigrow.com", "custom_domain": true }],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "cbb6243e55f24865bf34f3b8bf66a641" }],
      "vars": {
        "CACTIGROW_ENVIRONMENT": "staging",
        "CACTIGROW_VERSION": "0.0.0",
        "CACTIGROW_REALTIME_ENABLED": "true",
        "CACTIGROW_REALTIME_ORIGIN": "https://dev.cactigrow.com",
        "CACTIGROW_ACCESS_TEAM_DOMAIN": "https://sweet-union-f685.cloudflareaccess.com",
        "CACTIGROW_ACCESS_AUDIENCE": "21735907a315e47f6bb0a1f671b72aa123d269765a4bd5d528d677b314a7bd91"
      }
    },
    "production": {
      "name": "cactigrow-api-production",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [{"pattern":"cactigrow.com","custom_domain":true},{"pattern":"www.cactigrow.com","custom_domain":true}],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "158393f7112548959359357702fe183f" }],
      // Preserve the existing live production Custom Domain attachments.
      // User-approved initial launch shares the existing cactigrow database with development.
      "durable_objects": { "bindings": [{ "name": "AREA_PRESENCE", "class_name": "AreaPresence" }] },
      "exports": { "AreaPresence": { "type": "durable-object", "storage": "sqlite" } },
      "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
      "vars": {
        "CACTIGROW_ENVIRONMENT": "production",
        "CACTIGROW_NEON_AUTH_URL": "https://ep-wild-pond-arf5s9do.neonauth.c-4.us-west-2.aws.neon.tech/cactigrow/auth",
        "CACTIGROW_VERSION": "0.0.0",
        "CACTIGROW_REALTIME_ENABLED": "true",
        "CACTIGROW_REALTIME_ORIGIN": "https://cactigrow.com"
      }
    }
  }
}
