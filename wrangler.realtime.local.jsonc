{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cactigrow-realtime-local-only",
  "main": "server/realtime/worker.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "AREA_PRESENCE", "class_name": "AreaPresence" }]
  },
  "exports": {
    "AreaPresence": { "type": "durable-object", "storage": "sqlite" }
  }
}
