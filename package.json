    "test:starting": "node --experimental-strip-types --test shared/api/startingExperienceV1.test.ts src/features/starting/tutorialGuidance.test.ts src/features/starting/tutorialClock.test.ts server/starting/starting.integration.test.mjs",
    "test:reconciliation": "node --experimental-strip-types --test src/app/playerAuthorityReconciliation.test.ts",
    "test:chat": "node --experimental-strip-types --test --test-isolation=none server/realtime/chatScopes.test.ts server/realtime/admission.runtime.test.ts src/features/social/chatViewport.test.ts",
    "test:mail": "node --experimental-strip-types --test shared/api/mailV1.test.ts server/player/mail.integration.test.mjs",
    "mail:rollout": "node --experimental-strip-types scripts/mail-rollout.ts",
    "test:social:viewport": "node --experimental-strip-types --test src/features/social/social.viewport.test.mjs",
    "admin:owner": "node --experimental-strip-types scripts/admin-owner.ts",
    "admin:bootstrap-owner": "node --experimental-strip-types scripts/admin-owner.ts",
    "test:admin": "node --experimental-strip-types --test --test-isolation=none server/admin/admin.test.ts src/features/admin/admin.runtime.test.mjs src/features/admin/admin.viewport.test.mjs",
    "test:admin:db": "node --experimental-strip-types --test server/admin/admin.integration.test.mjs",
    "dev": "npm run world:generate && vite",
    "dev:worker": "wrangler dev --env development --config wrangler.jsonc --port 8788",
    "build": "npm run build:production",
