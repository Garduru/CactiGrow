{
  "name": "cactigrow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --config wrangler.jsonc",
    "build": "npm run worker:types && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "worker:types": "wrangler types server/worker-configuration.d.ts --env-interface CloudflareEnv --config wrangler.jsonc",
    "worker:types:check": "wrangler types server/worker-configuration.d.ts --env-interface CloudflareEnv --config wrangler.jsonc --check",
    "typecheck:worker": "npm run worker:types && tsc -p server/tsconfig.json",
    "test:worker": "node --experimental-strip-types --test --test-isolation=none server/api/handler.test.ts",
    "test:client": "node --experimental-strip-types --test --test-isolation=none src/services/api/CactiGrowApiClient.test.ts",
    "check:worker": "npm run worker:types && npm run worker:types:check && tsc -p server/tsconfig.json && npm run test:worker && wrangler deploy --dry-run --env=\"\" --config wrangler.jsonc --outdir .wrangler/dry-run",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.migrate.config.ts",
    "test:db": "node --experimental-strip-types --test --test-isolation=none server/db/integration.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7",
    "pg": "^8.23.0",
    "phaser": "^3.90.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "wrangler": "^4.135.0"
  }
}
