{
  "name": "cactigrow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --env development --config wrangler.jsonc",
    "build": "npm run build:production",
    "build:staging": "npm run worker:types && tsc -b && vite build --mode staging",
    "build:production": "npm run worker:types && tsc -b && vite build --mode production",
    "lint": "eslint .",
    "preview": "vite preview",
    "worker:types": "wrangler types server/worker-configuration.d.ts --env-interface CloudflareEnv --config wrangler.jsonc",
    "worker:types:check": "wrangler types server/worker-configuration.d.ts --env-interface CloudflareEnv --config wrangler.jsonc --check",
    "typecheck:worker": "npm run worker:types && tsc -p server/tsconfig.json",
    "test:worker": "node --experimental-strip-types --test --test-isolation=none server/api/handler.test.ts server/identity/CloudflareAccessJwtVerifier.test.ts",
    "test:client": "node --experimental-strip-types --test --test-isolation=none src/services/api/CactiGrowApiClient.test.ts",
    "test:garden": "node --experimental-strip-types --test --test-isolation=none src/features/garden/gardenSale.test.ts server/gameplay/gardenSaleLock.test.ts",
    "test:realtime": "node --experimental-strip-types --test --test-isolation=none server/realtime/areas.test.ts server/realtime/layerAssignment.test.ts server/realtime/presenceState.test.ts server/realtime/protocolV1.test.ts server/realtime/realtimeAdmissionV1.test.ts",
    "test:realtime:runtime": "node --experimental-strip-types --test --test-isolation=none server/realtime/AreaCoordinator.test.ts server/realtime/AreaPresence.runtime.test.ts",
    "test:realtime:admission": "node --experimental-strip-types --test --test-isolation=none server/realtime/admissionContracts.test.ts server/realtime/admission.runtime.test.ts",
    "check:worker": "npm run worker:types && npm run worker:types:check && tsc -p server/tsconfig.json && npm run test:worker",
    "dry-run:development": "wrangler deploy --dry-run --env development --config wrangler.jsonc --outdir .wrangler/dry-run-development",
    "dry-run:staging": "wrangler deploy --dry-run --env staging --config wrangler.jsonc --outdir .wrangler/dry-run-staging",
    "dry-run:production": "wrangler deploy --dry-run --env production --config wrangler.jsonc --outdir .wrangler/dry-run-production",
    "deploy:staging": "node --experimental-strip-types scripts/deploy-environment.ts staging",
    "deploy:production": "node --experimental-strip-types scripts/deploy-environment.ts production",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.migrate.config.ts",
    "test:db": "node --experimental-strip-types --test --test-isolation=none server/db/integration.test.ts"
    ,"db:provision:development-seeds": "node --experimental-strip-types server/development/provisionSeedFixtures.ts",
    "db:provision:staging-seeds": "node --experimental-strip-types server/staging/provisionSeedFixtures.ts",
    "test:e1": "node --experimental-strip-types --test --test-isolation=none server/gameplay/plantLifecycleRules.test.ts server/gameplay/breedingRules.test.ts server/gameplay/bredSeedPlanting.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7",
    "pg": "^8.23.0",
    "phaser": "^3.90.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "wrangler": "^4.135.0"
  }
}
