    "test:world:browser": "node --test src/game-world/world.browser.test.mjs",
    "test:settlement": "node --experimental-strip-types --test shared/world/settlement.test.ts",
    "test:settlement:browser": "node --test src/game-world/settlement.browser.test.mjs",
    "test:basin-environment": "node --experimental-strip-types --test shared/world/basinEnvironment.test.mjs src/game-world/basinEnvironmentPresentation.test.ts",
    "test:basin-environment:browser": "node --test src/game-world/basinEnvironment.browser.test.mjs",
    "test:exploration": "node --experimental-strip-types --test --test-force-exit shared/world/basinExploration.test.mjs shared/api/explorationV1.test.ts server/exploration/explorationReach.test.ts server/exploration/exploration.integration.test.mjs src/features/exploration/explorationPresentation.test.ts",
    "test:exploration:browser": "node --test src/features/exploration/exploration.browser.test.mjs",
    "test:field-survey": "node --experimental-strip-types --test --test-force-exit shared/world/fieldSurvey.test.mjs shared/api/fieldSurveyV1.test.ts server/quests/fieldSurvey.integration.test.mjs",
    "test:field-survey:browser": "node --test src/features/field-survey/fieldSurvey.browser.test.mjs",
    "town:author": "node scripts/town-content-v1.mjs --all",
    "test:town-content": "node --experimental-strip-types --test --test-force-exit shared/world/townContent.test.mjs shared/world/townGeometry.test.ts shared/api/townContentV1.test.ts server/town/townContent.integration.test.mjs src/features/town-content/townContent.test.ts",
    "test:town-content:browser": "node --test src/features/town-content/townContent.browser.test.mjs",
    "test:movement": "node --experimental-strip-types --test server/movement/movement.test.ts src/game-world/WorldMovementClient.test.ts server/movement/movement.integration.test.mjs server/movement/movement.runtime.test.mjs",
    "test:wild-genetics": "node --experimental-strip-types --test --test-force-exit server/exploration/wildGenetics.integration.test.mjs",
    "wild-genetics:rollout": "node --experimental-strip-types scripts/wild-genetics-rollout.ts",
    "wild-genetics:rollout:production": "node --experimental-strip-types scripts/wild-genetics-production-rollout.ts"
